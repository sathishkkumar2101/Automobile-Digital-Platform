# Copy to .env and fill in real values. .env is git-ignored on purpose.

# REQUIRED. HMAC-SHA256 signing key, minimum 32 characters, shared by
# api-gateway, user-role-service and messaging-service. Anyone holding this key
# can mint a token for any user id, including an administrator.
#
# Generate one with:
#   python -c "import secrets,string; al=string.ascii_letters+string.digits; print(''.join(secrets.choice(al) for _ in range(64)))"
JWT_SECRET=

# Token issuer and audience. Both the gateway and the messaging service pin
# these, so a token minted by an unrelated service sharing the key is rejected.
JWT_ISSUER=bmw-vehicle-platform
JWT_AUDIENCE=bmw-vehicle-platform-api

# Shared secret the API gateway presents to user-role-service and
# permission-service on their internal endpoints. Must be at least 32 chars.
# Generate a different value from JWT_SECRET.
INTERNAL_SERVICE_SECRET=
